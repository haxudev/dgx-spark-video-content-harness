<div class="scene-eyebrow"><span class="num">④</span>观看边界</div>
<div class="scene-title">{{title}}</div>

<div class="boundary-dashboard" aria-label="观看策略视觉仪表盘">
  <div class="boundary-card compass">
    <div class="boundary-icon">🧭</div>
    <div class="boundary-chart" data-boundary-map></div>
  </div>
  <div class="boundary-card balance">
    <div class="boundary-icon">⚖️</div>
    <div class="boundary-chart" data-boundary-balance></div>
  </div>
  <div class="boundary-card tempo">
    <div class="boundary-icon">〽️</div>
    <div class="boundary-chart" data-boundary-goals></div>
  </div>
  <div class="boundary-card brake">
    <div class="boundary-icon">🛑</div>
    <div class="boundary-chart" data-boundary-safety></div>
  </div>
</div>
