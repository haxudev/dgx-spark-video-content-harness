<div>
  <div class="scene-title">{{title}}</div>
  {{#each data.barLists}}
    {{#if title}}<div class="scene-subtitle">{{title}}</div>{{/if}}
    {{#each items}}
      <div class="bar-row">
        <div class="label">{{trim label 12}}</div>
        <div class="bar">
          <div class="fill" data-scale="{{probability}}"></div>
          <div class="pct">{{pctFrac probability}}</div>
        </div>
      </div>
    {{/each}}
  {{/each}}
</div>
