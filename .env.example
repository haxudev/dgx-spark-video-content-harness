# Local Qwen3-TTS (primary)
#   named voices  -> QWEN_TTS_BASE_URL  /v1/tts          (CustomVoice service)
#   voice cloning -> QWEN_TTS_CLONE_URL /v1/voice_clone  (Base service)
QWEN_TTS_BASE_URL=http://nuc.haxu.home:8568/v1
QWEN_TTS_CLONE_URL=http://nuc.haxu.home:8569/v1
# Bearer token for the Qwen3-TTS service (falls back to API_KEY).
QWEN_TTS_API_KEY=
QWEN_TTS_LANGUAGE=Chinese
# Optional named-voice overrides (defaults: Vivian female / Dylan male / Uncle_Fu narrator)
# QWEN_TTS_VOICE_FEMALE=Vivian
# QWEN_TTS_VOICE_MALE=Dylan
# QWEN_TTS_VOICE_NARRATOR=Uncle_Fu   # monologue single-host (解局人); falls back to MALE
# Optional per-role style control (natural language)
# QWEN_TTS_INSTRUCT_FEMALE=活泼少女中文女声，足球解说语气，语速适中，自然口语。
# QWEN_TTS_INSTRUCT_MALE=阳光年轻中文男声，足球解说语气，语速适中，自然口语。
# Custom voice clone — point a role at a reference wav (Base model on :8569):
# QWEN_TTS_CLONE_REF_NARRATOR=/home/nuc/openclaw-artifacts/custom_voice/merged.wav
# QWEN_TTS_CLONE_REF_TEXT_NARRATOR=参考音频的逐字稿（可选，启用更高保真的 ICL 克隆）
# Per-run alternative: `harness run … --voice <name>` (named) or `--clone-ref <wav>`
# (clone). Both are mode-aware (monologue→Narrator, podcast→both hosts). qwen backend only.

# TTS backend selector: qwen | azure | auto (default azure = reliable Azure neural, then stub)
HARNESS_TTS_PROVIDER=qwen
# Azure TTS transient-failure retries before falling back to the silent stub (default 3)
# AZURE_TTS_RETRIES=3

# Azure Speech (TTS fallback)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastus
# Optional Azure voice overrides (defaults: Xiaoxiao female / Yunxi male)
# AZURE_VOICE_FEMALE=zh-CN-XiaoxiaoNeural
# AZURE_VOICE_MALE=zh-CN-YunxiNeural

# Azure OpenAI (StoryboardAgent / DialogueWriter / Verifier-LLM)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_KEY=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-5.4
AZURE_OPENAI_CHAT_MODEL=gpt-5.4
azure_openai_chat_model=gpt-5.4
AZURE_OPENAI_API_VERSION=2025-04-01-preview

# Azure OpenAI image generation (gpt-image-2) — agent-authored opening cover
# poster and persistent background image. Optional: when the deployment is unset
# (or generation fails) COMPOSE silently falls back to the normal composition,
# so the pipeline and offline tests still run without credentials.
AZURE_OPENAI_IMAGE_DEPLOYMENT=
# Image API version + size are optional; sensible defaults are applied.
AZURE_OPENAI_IMAGE_API_VERSION=2025-04-01-preview
AZURE_OPENAI_IMAGE_SIZE=1024x1536
# Opening cover overlay length in seconds (does not extend the audio timeline).
HARNESS_COVER_SEC=3.2
# Set to 1 to skip opening cover image generation even when configured.
HARNESS_SKIP_COVER=
# Set to 1 to skip background image generation even when configured.
HARNESS_SKIP_BGIMAGE=

# Bottom digital-human presenter (LongCat-Video-Avatar) — replaces on-screen
# subtitles. The PIPELINE IS CACHE-ONLY: the AVATAR phase only consumes
# pre-generated clips from the version-controlled library (assets/avatar-clips/)
# and NEVER calls longcat, so a normal run can never pause the co-located qwen
# brain. On a miss it ships a framed placeholder band (avatar-cache-miss WARN).
#
# LONGCAT_AVATAR_BASE_URL is needed ONLY by the out-of-band `harness avatar-prewarm`
# command, which generates clips and persists them into the library (each clip
# takes ~10-12 min on the GPU and PAUSES qwen — run it deliberately). Inspect the
# library with `harness avatar-library`.
LONGCAT_AVATAR_BASE_URL=
# Optional bearer token if the service sets LONGCAT_API_KEY.
LONGCAT_API_KEY=
# Skip the avatar entirely (ship the placeholder; fast/draft profiles default this to 1).
HARNESS_SKIP_AVATAR=
# Hard-fail the run on a cache miss (default: graceful WARN, ship deck placeholder).
# HARNESS_REQUIRE_AVATAR=1
# Material-library dir (version-controlled). Default: assets/avatar-clips.
# HARNESS_AVATAR_LIBRARY_DIR=assets/avatar-clips
# Avatar render knobs. Run flags --avatar-image/--avatar-resolution/--avatar-segments
# affect lookup; for generation use the matching `avatar-prewarm` flags.
# HARNESS_AVATAR_RESOLUTION=480p          # 480p (default) or 720p (slower)
# HARNESS_AVATAR_SEGMENTS=1               # each ≈3.7s / ≈10 min
# HARNESS_AVATAR_ASSET_DIR=/home/nuc/openclaw-artifacts/podcast_avator
# HARNESS_AVATAR_IMAGE_PODCAST=.../two-people.png      # dual-host source image
# HARNESS_AVATAR_IMAGE_MONOLOGUE=.../single-people.png # 解局人 source image
# HARNESS_AVATAR_DRIVE_AUDIO=/path/to/ref.wav          # avatar-prewarm: pin driving audio (else prior runs' opening TTS)
# HARNESS_AVATAR_CROP_BIAS=0.12           # vertical crop bias into the band (0=keep top)
# Dual-host lip-sync (podcast): RENDER splits the band at centre and freezes the
# idle host's half to a still whenever they are silent, so only the talking host's
# mouth moves (driven by the TTS speaker timeline; no extra GPU).
# HARNESS_AVATAR_LEFT_SPEAKER=Anchor      # which speaker is on the left (default Anchor=女)
# HARNESS_AVATAR_RIGHT_SPEAKER=Analyst    # which speaker is on the right (default Analyst=男)
# HARNESS_AVATAR_LIPSYNC_PAD=0.12         # seconds the moving half leads/trails speech
# HARNESS_AVATAR_NO_SPLIT=1               # disable the split; keep the plain looped band

# Optional fallback: plain OpenAI
OPENAI_API_KEY=

# Hyperframes
# Renders need chrome + ffmpeg in PATH; nothing else to configure.

# Pipeline behaviour
HARNESS_WORK_DIR=out
HARNESS_LLM_MODEL=gpt-4.1
HARNESS_TTS_PARALLEL=4
HARNESS_LLM_MAX_RETRIES=3

# Jina Reader (web fetch tool — scripts/fetch-jina.mjs)
JINA_READER_BASE_URL=https://r.jina.ai
# JINA_READER_API_KEY=your-key  # Optional: boosts quota, unlocks search
# JINA_SEARCH_BASE_URL=https://s.jina.ai

# Optional pacing target. Runtime is advisory; VERIFY_AV checks audio/video sync.
# HARNESS_MAX_DURATION_SEC=120
# HARNESS_TARGET_DURATION_SEC=95
