# ── Hosted-agent (MAF harness agent) configuration ───────────────────────────
# These knobs configure the Python orchestration agent only. The harness
# pipeline itself still reads the existing harness vars (GX10_* / AZURE_* / TTS)
# from your main `.env` — see .env.example at the repo root.

# Orchestration model (the agent "brain"). Defaults to the harness GX10 vars
# (GX10_OPENAI_BASE_URL / GX10_OPENAI_API_KEY / GX10_MODEL_NAME) when unset, so a
# single .env usually suffices. Override only to point the brain elsewhere.
# AGENT_MODEL_BASE_URL=http://gx10.haxu.home:8000/v1
# AGENT_MODEL_API_KEY=sk-...
# AGENT_MODEL_NAME=qwen3.6-35b

# create_harness_agent token budgets.
# AGENT_MAX_CONTEXT_TOKENS=32000
# AGENT_MAX_OUTPUT_TOKENS=2048

# Optional batteries (off by default for a lean, 35B-friendly single-tool agent).
# AGENT_ENABLE_TODO=0
# AGENT_ENABLE_MODE=0
# AGENT_ENABLE_MEMORY=0
# AGENT_ENABLE_WEB_SEARCH=0

# Server bind.
# AGENT_HOST=0.0.0.0
# AGENT_PORT=8088   # default; set another port (this host uses 8089) if 8088 is
#                   # already taken — e.g. by a caddy reverse proxy on the host.
AGENT_NAME=football-video-agent

# How the agent invokes the Node harness inside the container.
# HARNESS_BIN=node /app/dist/cli.js
# HARNESS_DIR=/app
# Hard cap (seconds) on a single pipeline run before the tool reports a timeout.
# HARNESS_AGENT_JOB_TIMEOUT=3600
# Retry a *signal-killed* run (e.g. -9 SIGKILL from a transient host OOM, which
# leaves no result manifest) this many times before giving up. A real non-zero
# pipeline error is never retried. Set 0 to disable.
# HARNESS_AGENT_SIGNAL_RETRIES=1

# Silence the Azure IMDS probe from the OTel distro when running off-Azure.
OTEL_SDK_DISABLED=true
